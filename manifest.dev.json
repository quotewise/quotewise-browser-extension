{
  "manifest_version": 3,
  "name": "Quotewise Quote Capture - Dev",
  "version": "1.7.2",
  "description": "Save quotes from X, Threads, Bluesky & Substack Notes to your Quotewise library — attributed, sourced, duplicate-checked.",
  "permissions": [
    "storage",
    "identity",
    "alarms",
    "webNavigation",
    "scripting"
  ],
  "host_permissions": [
    "https://*.quotewise.io/*",
    "http://*.quotewise.test:8000/*",
    "http://localhost:8001/*",
    "https://twitter.com/*",
    "https://x.com/*",
    "https://threads.com/*",
    "https://*.threads.com/*",
    "https://threads.net/*",
    "https://*.threads.net/*",
    "https://bsky.app/*",
    "https://substack.com/*",
    "https://*.substack.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*",
        "https://threads.com/*",
        "https://*.threads.com/*",
        "https://threads.net/*",
        "https://*.threads.net/*",
        "https://bsky.app/*",
        "https://substack.com/*",
        "https://*.substack.com/*"
      ],
      "js": [
        "content/index.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://quotewise.io/oauth/extension-callback*",
        "https://*.quotewise.io/oauth/extension-callback*"
      ],
      "js": [
        "content/oauth-callback.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Quotewise",
    "default_icon": {
      "16": "icons/icon16-grey.png",
      "32": "icons/icon32-grey.png",
      "48": "icons/icon48-grey.png",
      "128": "icons/icon128-grey.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
