# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# This project uses Bun (bun.lock) — keep other package managers' lockfiles out.
# A stale package-lock.json diverges from the bun tree and gets scanned by
# Dependabot in isolation (see CLAUDE.md "Always use Bun").
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build outputs
dist/
build/

# Environment variables
.env*
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code local settings
.claude/settings.local.json
.mcp.json

# Beads redirect to the canonical Dolt store in ../quotewise/.beads
# (machine-specific absolute path; see CLAUDE.md "Beads issue tracker")
.beads/

